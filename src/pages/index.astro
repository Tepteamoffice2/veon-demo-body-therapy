---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/sections/Hero.astro";
import Pidbir from "../components/sections/Pidbir.astro";
import Rehab from "../components/sections/Rehab.astro";
import Studio from "../components/sections/Studio.astro";
import Prices from "../components/sections/Prices.astro";
import Certificates from "../components/sections/Certificates.astro";
import Courses from "../components/sections/Courses.astro";
import Contacts from "../components/sections/Contacts.astro";
import SiteFooter from "../components/SiteFooter.astro";
import CallBar from "../components/CallBar.astro";
import { contacts } from "../data/studio";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const title = "Масаж у Кременчуці — студія Body Therapy, лікувальний масаж";
const description = "Лікувальний, розслаблюючий, антицелюлітний, спортивний і дитячий масаж; реабілітація. вул. Першотравнева, 20. Запис за телефоном.";

// LocalBusiness markup without aggregateRating (R-SEO3). No url/image: the demo never points to the current site.
const ld = {
  "@context": "https://schema.org",
  "@type": "HealthAndBeautyBusiness",
  "@id": "#business",
  name: "Body Therapy",
  description: "Студія лікувального і відновлювального масажу та реабілітації в центрі Кременчука.",
  telephone: "+380680796731",
  email: contacts.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: contacts.street,
    addressLocality: contacts.city,
    postalCode: contacts.postal,
    addressRegion: "Полтавська область",
    addressCountry: "UA",
  },
  geo: { "@type": "GeoCoordinates", latitude: contacts.lat, longitude: contacts.lng },
  openingHoursSpecification: [{
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    opens: "09:00",
    closes: "20:00",
  }],
  priceRange: "500–2200 грн",
  currenciesAccepted: "UAH",
  paymentAccepted: "Готівка, картка, Google Pay, Apple Pay, Samsung Pay, безготівковий переказ",
  sameAs: [contacts.instagram],
};
---
<Base lang="uk" title={title} description={description}>
  <Fragment slot="head">
    <link rel="preload" href={`${base}fonts/piazzolla-cyrillic-wght-normal.woff2`} as="font" type="font/woff2" crossorigin data-rec="R-SP4" />
    <script type="application/ld+json" data-rec="R-SEO3" set:html={JSON.stringify(ld)} />
  </Fragment>
  <Header slot="header" />
  <Hero />
  <Pidbir />
  <Rehab />
  <Studio />
  <Prices />
  <Certificates />
  <Courses />
  <Contacts />
  <Fragment slot="footer">
    <SiteFooter />
    <CallBar />
  </Fragment>
</Base>

<script src="../scripts/page.ts"></script>
